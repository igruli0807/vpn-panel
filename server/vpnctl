def install_sstp(a):
    if host_sstp_active():
        say("note: a system accel-ppp is also running here; the container uses its own port")
    if not os.path.exists("/dev/ppp") or subprocess.run(["sh", "-c", "lsmod | grep -q '^ppp_generic'"]).returncode:
        say("loading kernel module ppp_generic")
        sh(["modprobe", "ppp_generic"])
        host_write("sstp", "/etc/modules-load.d/vpnctl-ppp.conf", "ppp_generic\n", 0o644)
    image = ensure_image("sstp")
    os.makedirs(SSTP_DIR, mode=0o700, exist_ok=True)
    conf = f"{SSTP_DIR}/accel-ppp.conf"
    if os.path.exists(conf) and not a.port:
        port = int(ini_get(host_read(conf), "sstp", "port"))
        say(f"keeping existing config (TCP {port})")
    else:
        port = pick_port("tcp", a.port)
        host_write("sstp", conf, SSTP_CONF_TEMPLATE.format(port=port), 0o644)
    if not os.path.exists(f"{SSTP_DIR}/chap-secrets"):
