def say(msg):
    print(f"[vpnctl] {msg}", flush=True)


def public_ip():
    p = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True)
    m = re.search(r"\bsrc (\S+)", p.stdout)
    return m.group(1) if m else ""


def busy_ports(proto):
    p = subprocess.run(["ss", "-Hln" + ("t" if proto == "tcp" else "u")], capture_output=True, text=True)
    ports = set()
    for line in p.stdout.splitlines():
        f = line.split()
        if len(f) >= 4:
            port = f[3].rsplit(":", 1)[-1]
            if port.isdigit():
                ports.add(int(port))
    return ports


def pick_port(proto, wanted=None):
    busy = busy_ports(proto)
    if wanted:
        if int(wanted) in busy:
            raise Fail(f"{proto.upper()} port {wanted} is busy")
        return int(wanted)
    import secrets as _s
    for _ in range(100):
        p = 20000 + _s.randbelow(40000)
        if p not in busy:
            return p
    raise Fail("no free port")


def ensure_docker():
    if subprocess.run(["sh", "-c", "command -v docker"], capture_output=True).returncode == 0:
        return
    say("docker is not installed — installing docker.io (apt)")
    sh(["sh", "-c", "DEBIAN_FRONTEND=noninteractive apt-get update -qq && "
                    "DEBIAN_FRONTEND=noninteractive apt-get install -y -qq docker.io >/dev/null && systemctl enable --now docker"],
       timeout=900)


def ensure_image(proto):
    local, remote = LOCAL_IMAGES[proto], REMOTE_IMAGES[proto]
    if sh(["docker", "image", "inspect", local], check=False).returncode == 0:
        return local
    say(f"pulling {remote}")
    sh(["docker", "pull", "-q", remote], timeout=900)
    sh(["docker", "tag", remote, local])
    return local


def free_mb():
    st = os.statvfs("/")
    return st.f_bavail * st.f_frsize // (1024 * 1024)


def wait_for(check, seconds=30):
    for _ in range(seconds):
        if check():
            return True
        time.sleep(1)
    return False


def install_awg3(a):
    image = ensure_image("awg3")
    script = os.path.join(LIB_DIR, "install-awg3.sh")
    args = [script] + (["--port", str(a.port)] if a.port else [])
    p = subprocess.run(args, capture_output=True, text=True, timeout=300, env=dict(os.environ, AWG3_IMAGE=image))
    for line in (p.stdout + p.stderr).splitlines():
        say(line.strip())
    if p.returncode != 0:
        raise Fail("install-awg3.sh failed")
    return {"ok": True, "unit": "awg3", "port": awg_info("awg3")["port"]}


