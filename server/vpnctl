def unit_kind(name):
    if name in KINDS:
        return "awg"
    if name in ("sstp", "sstp-host"):
        return "sstp"
    if name == "xray":
        return "vless"
    raise Fail(f"unsupported unit: {name}")


def running_units():
    names = docker_names()
    units = [n for n in names if n in KINDS or n in ("sstp", "xray")]
    if host_sstp_active():
        units.append("sstp-host")
    return units


