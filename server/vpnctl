def unit_kind(name):
    if name in KINDS:
        return "awg"
    if name in ("sstp", "sstp-host"):
        return "sstp"
    if name == "xray":
        return "vless"
    if name == "telemt":
        return "telemt"
    if name == "mtg-doppel":
        return "mtg"
    raise Fail(f"unsupported unit: {name}")


def running_units():
    names = docker_names()
    units = [n for n in names if n in KINDS or n in ("sstp", "xray")]
    # Telegram proxies are listed only when their config is where vpnctl keeps it (containers of the same name
    # started by hand elsewhere are not ours)
    units += [n for n, conf in (("telemt", tm_conf_path()), ("mtg-doppel", f"{MTG_DIR}/config.toml"))
              if n in names and os.path.exists(conf)]
    if host_sstp_active():
        units.append("sstp-host")
    return units


