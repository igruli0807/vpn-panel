def install_sstp(a):
    if host_sstp_active():
        say("note: a system accel-ppp is also running here; the container uses its own port")
    if not os.path.exists("/dev/ppp") or subprocess.run(["sh", "-c", "lsmod | grep -q '^ppp_generic'"]).returncode:
        say("loading kernel module ppp_generic")
        sh(["modprobe", "ppp_generic"])
        host_write("sstp", "/etc/modules-load.d/vpnctl-ppp.conf", "ppp_generic\n", 0o644)
    image = ensure_image("sstp")
    os.makedirs(SSTP_DIR, mode=0o700, exist_ok=True)
    conf = f"{SSTP_DIR}/accel-ppp.conf"
    if os.path.exists(conf) and not a.port:
        port = int(ini_get(host_read(conf), "sstp", "port"))
        say(f"keeping existing config (TCP {port})")
    else:
        port = pick_port("tcp", a.port)
        host_write("sstp", conf, SSTP_CONF_TEMPLATE.format(port=port), 0o644)
    if not os.path.exists(f"{SSTP_DIR}/chap-secrets"):
        host_write("sstp", f"{SSTP_DIR}/chap-secrets", "", 0o600)
    if a.cert or a.key:
        if not (a.cert and a.key and os.path.isfile(a.cert) and os.path.isfile(a.key)):
            raise Fail("--cert and --key must both point to existing files")
        say(f"using certificate {a.cert}")
        host_write("sstp", f"{SSTP_DIR}/server.crt", host_read(a.cert), 0o644)
        host_write("sstp", f"{SSTP_DIR}/server.key", host_read(a.key), 0o600)
    if not os.path.exists(f"{SSTP_DIR}/server.crt"):
        ip = public_ip()
        san = f"IP:{ip}" + (f",DNS:{a.domain}" if a.domain else "")
        cn = a.domain or ip
        say(f"self-signed certificate for {cn} (10 years)")
        sh(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650", "-subj", f"/CN={cn}",
            "-addext", f"subjectAltName={san}", "-keyout", f"{SSTP_DIR}/server.key", "-out", f"{SSTP_DIR}/server.crt"])
        os.chmod(f"{SSTP_DIR}/server.key", 0o600)
    sh(["docker", "rm", "-f", "sstp"], check=False)
    sh(["docker", "run", "-d", "--name", "sstp", "--restart", "unless-stopped", "--cap-add", "NET_ADMIN",
        "--device", "/dev/ppp", "--sysctl", "net.ipv4.ip_forward=1", "-p", f"{port}:{port}/tcp",
        "-v", f"{SSTP_DIR}:/etc/accel-ppp", "--log-driver", "json-file", "--log-opt", "max-size=5m",
        "--log-opt", "max-file=2", "--memory", "128m", image])
    u = sstp_unit("sstp")
    if not wait_for(lambda: accel(u, "show", "stat").returncode == 0, 30):
        raise Fail("sstp container started but accel-ppp does not answer; see: docker logs sstp")
    say(f"SSTP is running on TCP {port}")
    return {"ok": True, "unit": "sstp", "port": port}


SNI_CANDIDATES = ["www.apple.com", "dl.google.com", "www.microsoft.com"]


def xr_selftest(image, port, pbk, sid, sni, flow="xtls-rprx-vision"):
    """Real REALITY client on this host: temp user -> xray client (host network) -> HTTP 204 through the tunnel.
    `xray tls ping` alone is not enough: www.microsoft.com passes it, yet REALITY handshakes to it fail."""
    if subprocess.run(["sh", "-c", "command -v curl"], capture_output=True).returncode != 0:
        say("curl is not installed — skipping the end-to-end self-test")
        return True
    import uuid as _u
    tmp_id = str(_u.uuid4())
    _, inbound, _, _ = xr_load()
    xr_live_add(inbound, {"id": tmp_id, "email": tmp_id, "flow": flow})
    socks = pick_port("tcp")
    cfg = {"log": {"loglevel": "warning"},
           "inbounds": [{"listen": "127.0.0.1", "port": socks, "protocol": "socks", "settings": {"udp": False}}],
           "outbounds": [{"protocol": "vless", "settings": {"vnext": [{"address": "127.0.0.1", "port": port,
                          "users": [{"id": tmp_id, "encryption": "none", "flow": flow}]}]},
                          "streamSettings": {"network": "tcp", "security": "reality",
                                             "realitySettings": {"serverName": sni, "fingerprint": "chrome",
                                                                 "publicKey": pbk, "shortId": sid}}}]}
    sh(["docker", "rm", "-f", "vpnctl-selftest"], check=False)
    ok = False
    try:
        sh(["docker", "run", "-d", "--name", "vpnctl-selftest", "--network", "host", "--entrypoint", "sh", image, "-c",
            "cat > /tmp/c.json <<'JSON'\n" + json.dumps(cfg) + "\nJSON\nexec xray run -config /tmp/c.json"])
        for _ in range(8):
            time.sleep(1)
            p = subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", "6", "-w", "%{http_code}", "--socks5-hostname",
                                f"127.0.0.1:{socks}", "http://cp.cloudflare.com/generate_204"], capture_output=True, text=True)
            if p.stdout.strip() in ("204", "200"):
                ok = True
                break
    finally:
        sh(["docker", "rm", "-f", "vpnctl-selftest"], check=False)
        xr_live_remove(tmp_id)
    return ok


def xr_write_config(port, priv, pub, sid, sni, clients):
    f = xr_files()
    cfg = {
        "log": {"loglevel": "warning"},
        "api": {"tag": "api", "listen": XRAY_API, "services": ["HandlerService", "StatsService"]},
        "stats": {},
        "policy": {"levels": {"0": {"statsUserUplink": True, "statsUserDownlink": True, "statsUserOnline": True}},
                   "system": {"statsInboundUplink": True, "statsInboundDownlink": True}},
        "inbounds": [{"tag": XRAY_TAG, "listen": "0.0.0.0", "port": port, "protocol": "vless",
                      "settings": {"clients": clients, "decryption": "none"},
                      "streamSettings": {"network": "tcp", "security": "reality",
                                         "realitySettings": {"dest": f"{sni}:443", "serverNames": [sni],
                                                             "privateKey": priv, "shortIds": [sid]}},
                      "sniffing": {"enabled": True, "destOverride": ["http", "tls", "quic"]}}],
        "outbounds": [{"protocol": "freedom", "tag": "direct"}, {"protocol": "blackhole", "tag": "block"}],
    }
    host_write("xray", f["config"], json.dumps(cfg, ensure_ascii=False, indent=2))
    host_write("xray", f["meta"], json.dumps({"port": port, "public_key": pub, "short_id": sid, "sni": sni,
                                              "flow": "xtls-rprx-vision", "fp": "chrome"}, indent=2))
    if not os.path.exists(f["disabled"]):
        host_write("xray", f["disabled"], "[]")


def xr_run(image, port):
    sh(["docker", "rm", "-f", "xray"], check=False)
    sh(["docker", "run", "-d", "--name", "xray", "--restart", "unless-stopped", "-p", f"{port}:{port}/tcp",
        "-v", f"{XRAY_DIR}:/etc/xray", "--log-driver", "json-file", "--log-opt", "max-size=5m",
        "--log-opt", "max-file=2", "--memory", "128m", image])
    if not wait_for(xr_up, 30):
        raise Fail("xray container started but its API does not answer; see: docker logs xray")


def install_vless(a):
    image = ensure_image("vless")
    os.makedirs(XRAY_DIR, mode=0o700, exist_ok=True)
    f = xr_files()
    cfg = load_json_file(f["config"], None)
    if cfg and not a.port and not a.sni:
        meta = load_json_file(f["meta"], {})
        port = next(i for i in cfg["inbounds"] if i.get("tag") == XRAY_TAG)["port"]
        say(f"keeping existing config and users (TCP {port}, SNI {meta.get('sni')})")
        xr_run(image, port)
        return {"ok": True, "unit": "xray", "port": port, "sni": meta.get("sni")}
    port = pick_port("tcp", a.port)
    clients = next(i for i in cfg["inbounds"] if i.get("tag") == XRAY_TAG)["settings"]["clients"] if cfg else []
    keys = sh(["docker", "run", "--rm", "--entrypoint", "xray", image, "x25519"]).stdout
    priv = re.search(r"Private\s*[Kk]ey:\s*(\S+)", keys).group(1)
    pub = re.search(r"(?:Public\s*key|Password \(PublicKey\)):\s*(\S+)", keys).group(1)
    import secrets as _s
    sid = _s.token_hex(4)
    for sni in ([a.sni] if a.sni else SNI_CANDIDATES):
        say(f"trying REALITY target {sni}")
        ping = sh(["docker", "run", "--rm", "--entrypoint", "xray", image, "tls", "ping", sni], check=False, timeout=60)
        if ping.returncode != 0 or "TLS ping finished" not in ping.stdout:
            say(f"  {sni}: not reachable over TLS from this server")
            continue
        xr_write_config(port, priv, pub, sid, sni, clients)
        xr_run(image, port)
        if xr_selftest(image, port, pub, sid, sni):
            say(f"VLESS REALITY is running on TCP {port} (SNI {sni}), self-test passed")
            return {"ok": True, "unit": "xray", "port": port, "sni": sni}
        say(f"  {sni}: REALITY self-test failed")
    sh(["docker", "rm", "-f", "xray"], check=False)
    raise Fail("no REALITY target worked from this server; try install vless --sni <host>")


INSTALLERS = {"awg3": install_awg3, "sstp": install_sstp, "vless": install_vless}
UNIT_OF = {"awg3": "awg3", "sstp": "sstp", "vless": "xray"}
DATA_DIR = {"sstp": SSTP_DIR, "vless": XRAY_DIR}


def cmd_install(a):
    if os.geteuid() != 0:
        raise Fail("install needs root")
    if free_mb() < 300:
        raise Fail(f"only {free_mb()} MB free on /, need at least 300 MB")
    ensure_docker()
    if systemd_enabled("netfilter-persistent"):
        say("WARNING: netfilter-persistent is enabled — do not run 'netfilter-persistent save' while containers run")
    return INSTALLERS[a.proto](a)


def systemd_enabled(unit):
    return subprocess.run(["systemctl", "is-enabled", "--quiet", unit], capture_output=True).returncode == 0


def cmd_uninstall(a):
    if os.geteuid() != 0:
        raise Fail("uninstall needs root")
    if a.proto == "awg3":
        p = subprocess.run([os.path.join(LIB_DIR, "install-awg3.sh"), "--remove"], capture_output=True, text=True)
        say((p.stdout + p.stderr).strip())
        return {"ok": p.returncode == 0, "unit": "awg3", "kept": "/opt/awg3"}
    unit = UNIT_OF[a.proto]
    sh(["docker", "rm", "-f", unit], check=False)
    kept = None
    d = DATA_DIR[a.proto]
    if os.path.isdir(d):
        kept = f"{d}.removed-{time.strftime('%Y%m%d-%H%M%S')}"
        os.rename(d, kept)
    say(f"{unit} removed" + (f"; data moved to {kept}" if kept else ""))
    return {"ok": True, "unit": unit, "kept": kept}


def cmd_preflight(_a):
    docker = subprocess.run(["sh", "-c", "command -v docker"], capture_output=True).returncode == 0
    mem = {}
    for line in (host_read("/proc/meminfo", "") or "").splitlines():
        k, _, v = line.partition(":")
        mem[k] = int(v.split()[0]) // 1024 if v.split() else 0
    osr = {}
    for line in (host_read("/etc/os-release", "") or "").splitlines():
        k, _, v = line.partition("=")
        osr[k] = v.strip('"')
    return {"version": VERSION, "os": osr.get("PRETTY_NAME", "?"), "kernel": os.uname().release,
            "docker": docker, "free_mb": free_mb(), "mem_avail_mb": mem.get("MemAvailable", 0),
            "swap_mb": mem.get("SwapTotal", 0), "public_ip": public_ip(),
            "ppp": os.path.exists("/dev/ppp") or subprocess.run(["modinfo", "ppp_generic"], capture_output=True).returncode == 0,
            "units": running_units() if docker else (["sstp-host"] if host_sstp_active() else []),
            "tcp_busy": sorted(busy_ports("tcp")), "udp_busy": sorted(busy_ports("udp")),
            "netfilter_persistent": systemd_enabled("netfilter-persistent")}


def cmd_unlink(_a):
    """Remove the panel's key from authorized_keys (the panel forgets this server)."""
    path = "/root/.ssh/authorized_keys"
    lines = (host_read(path, "") or "").splitlines()
    keep = [x for x in lines if "vpn-panel@" not in x]
    host_write("ssh", path, "\n".join(keep) + ("\n" if keep else ""), 0o600)
    return {"ok": True, "removed": len(lines) - len(keep)}


def cmd_version(_a):
    return {"version": VERSION}


def build_parser():
    ap = argparse.ArgumentParser(prog="vpnctl")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    d = sub.add_parser("dump")
    d.add_argument("containers", nargs="*")
    for name in ("params", "next-ip"):
        sub.add_parser(name).add_argument("container")
    ad = sub.add_parser("add")
    ad.add_argument("container")
    ad.add_argument("--pub", required=True)
    ad.add_argument("--ip", default="")
    ad.add_argument("--name", default="")
    for name in ("remove", "disable", "enable"):
        x = sub.add_parser(name)
        x.add_argument("container")
        x.add_argument("--pub", required=True)
    sn = sub.add_parser("set-name")
    sn.add_argument("container")
    sn.add_argument("--pub", required=True)
    sn.add_argument("--name", required=True)
    ins = sub.add_parser("install")
    ins.add_argument("proto", choices=sorted(INSTALLERS))
    ins.add_argument("--port", type=int)
    ins.add_argument("--sni", default="")
    ins.add_argument("--domain", default="")
    ins.add_argument("--cert", default="", help="sstp: certificate chain file to use instead of a self-signed one")
    ins.add_argument("--key", default="", help="sstp: private key for --cert")
    un = sub.add_parser("uninstall")
    un.add_argument("proto", choices=sorted(INSTALLERS))
    for name in ("preflight", "unlink", "version"):
        sub.add_parser(name)
    return ap


HANDLERS = {"list": cmd_list, "dump": cmd_dump, "params": cmd_params, "next-ip": cmd_next_ip,
            "add": cmd_add, "remove": cmd_remove, "disable": cmd_disable, "enable": cmd_enable,
            "set-name": cmd_set_name, "install": cmd_install, "uninstall": cmd_uninstall,
            "preflight": cmd_preflight, "unlink": cmd_unlink, "version": cmd_version}
WRITES = {"add", "remove", "disable", "enable", "set-name", "install", "uninstall", "unlink"}


def main(argv):
    if argv[:1] == ["--ssh"]:
        # Forced command in authorized_keys: only "vpnctl <args>" (or the old name awgctl) runs.
        orig = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        if not orig or os.path.basename(orig[0]) not in ("vpnctl", "awgctl"):
            print(json.dumps({"error": "only vpnctl is allowed"}))
            return 2
        argv = orig[1:]
    try:
        a = build_parser().parse_args(argv)
    except SystemExit:
        print(json.dumps({"error": "bad arguments"}))
        return 2
    try:
        with open(LOCK, "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX if a.cmd in WRITES else fcntl.LOCK_SH)
            print(json.dumps(HANDLERS[a.cmd](a), ensure_ascii=False), flush=True)
        return 0
    except (Fail, ValueError, KeyError, StopIteration, json.JSONDecodeError, subprocess.TimeoutExpired) as e:
        print(json.dumps({"error": str(e) or e.__class__.__name__}, ensure_ascii=False), flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
