def install_vless(a):
    image = ensure_image("vless")
    os.makedirs(XRAY_DIR, mode=0o700, exist_ok=True)
    f = xr_files()
    cfg = load_json_file(f["config"], None)
    if cfg and not a.port and not a.sni:
        meta = load_json_file(f["meta"], {})
        port = next(i for i in cfg["inbounds"] if i.get("tag") == XRAY_TAG)["port"]
        say(f"keeping existing config and users (TCP {port}, SNI {meta.get('sni')})")
        xr_run(image, port)
        return {"ok": True, "unit": "xray", "port": port, "sni": meta.get("sni")}
    port = pick_port("tcp", a.port)
    clients = next(i for i in cfg["inbounds"] if i.get("tag") == XRAY_TAG)["settings"]["clients"] if cfg else []
    keys = sh(["docker", "run", "--rm", "--entrypoint", "xray", image, "x25519"]).stdout
    priv = re.search(r"Private\s*[Kk]ey:\s*(\S+)", keys).group(1)
    pub = re.search(r"(?:Public\s*key|Password \(PublicKey\)):\s*(\S+)", keys).group(1)
    import secrets as _s
    sid = _s.token_hex(4)
    for sni in ([a.sni] if a.sni else SNI_CANDIDATES):
        say(f"trying REALITY target {sni}")
        ping = sh(["docker", "run", "--rm", "--entrypoint", "xray", image, "tls", "ping", sni], check=False, timeout=60)
        if ping.returncode != 0 or "TLS ping finished" not in ping.stdout:
            say(f"  {sni}: not reachable over TLS from this server")
            continue
        xr_write_config(port, priv, pub, sid, sni, clients)
        xr_run(image, port)
        if xr_selftest(image, port, pub, sid, sni):
            say(f"VLESS REALITY is running on TCP {port} (SNI {sni}), self-test passed")
            return {"ok": True, "unit": "xray", "port": port, "sni": sni}
        say(f"  {sni}: REALITY self-test failed")
    sh(["docker", "rm", "-f", "xray"], check=False)
    raise Fail("no REALITY target worked from this server; try install vless --sni <host>")


def bridge_subnets():
    """Subnets of docker's default bridge: the telemt API sees requests from the host as coming from there."""
    p = sh(["docker", "network", "inspect", "bridge", "--format", "{{range .IPAM.Config}}{{.Subnet}} {{end}}"],
           check=False)
    return [x for x in p.stdout.split() if ":" not in x]


def tg_port(wanted, current, default, what):
    """Telegram proxies get a well-known default port (clients behind strict firewalls reach 443 best).
    `current` is the port our own running container already holds (not "busy")."""
    port = int(wanted or current or default)
    if port != current and port in busy_ports("tcp"):
        raise Fail(f"TCP port {port} is busy on this server" + ("" if wanted else f" (the default for {what})") +
                   " — choose another one with --port")
    return port


def tg_reachable(domain):
    """The site to pretend to be must be reachable from here over HTTPS, or the disguise shows nothing."""
    say(f"checking that {domain} answers over HTTPS from this server")
    try:
        req = urllib.request.Request(f"https://{domain}/", headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.geturl()
    except urllib.error.HTTPError as e:   # 403/404 on the front page is still a live HTTPS site
        return e.geturl() or f"https://{domain}/"
    except (OSError, ValueError) as e:
        raise Fail(f"{domain} does not answer over HTTPS from this server ({e}) — choose another --sni")


def tm_write_conf(text):
    d = os.path.dirname(tm_conf_path())
    os.makedirs(d, mode=0o700, exist_ok=True)
    host_write("telemt", tm_conf_path(), text, 0o600)
    for p in (d, tm_conf_path()):   # the API of telemt rewrites config.toml itself (temp file + rename)
        os.chown(p, TELEMT_UID, TELEMT_UID)
    os.chmod(d, 0o700)


def tm_run(image, text):
    public, inner, api = tm_ports(text)
    sh(["docker", "rm", "-f", "telemt"], check=False)
    api_host = api if api not in busy_ports("tcp") else pick_port("tcp")   # host side of the API: 127.0.0.1 only
    # the image is distroless (no shell), so its exec-form health check cannot be re-pointed at our config path
    sh(["docker", "run", "-d", "--name", "telemt", "--restart", "unless-stopped",
        "-p", f"{public}:{inner}/tcp", "-p", f"127.0.0.1:{api_host}:{api}/tcp",
        "-w", "/run/telemt", "-v", f"{TELEMT_DIR}/config:/etc/telemt:rw", "--tmpfs", "/run/telemt:rw,mode=1777,size=4m",
        "-e", "RUST_LOG=info", "--cap-drop", "ALL", "--cap-add", "NET_BIND_SERVICE", "--read-only",
        "--security-opt", "no-new-privileges:true", "--ulimit", "nofile=65536:262144", "--no-healthcheck",
        "--log-driver", "json-file", "--log-opt", "max-size=20m", "--log-opt", "max-file=3",
        image, "/etc/telemt/config.toml"])
    if not wait_for(tm_alive, 45):
        logs = sh(["docker", "logs", "--tail", "5", "telemt"], check=False)
        raise Fail("telemt container started but its API does not answer; see: docker logs telemt — "
                   + (logs.stdout + logs.stderr).strip()[-300:])
    return public


def install_telemt(a):
    image = ensure_image("telemt")
    old = host_read(tm_conf_path())
    if old is not None and not a.port and not a.sni:
        domain = toml_get(old, "censorship", "tls_domain")
        say(f"keeping existing config and users (TCP {tm_ports(old)[0]}, site {domain})")
        port = tm_run(image, old)
        tg_selftest("telemt", port, domain)
        return {"ok": True, "unit": "telemt", "port": port, "sni": domain}
    domain = (a.sni or (toml_get(old, "censorship", "tls_domain") if old else "") or "www.samsung.com").lower()
    check_domain(domain)
    port = tg_port(a.port, tm_ports(old)[0] if old else 0, 443, "telemt")   # all checks before anything is touched
    tg_reachable(domain)
    wl = ["127.0.0.1/32", "172.16.0.0/12"] + [x for x in bridge_subnets()
                                             if not ipaddress.ip_network(x).subnet_of(ipaddress.ip_network("172.16.0.0/12"))]
    text = TELEMT_CONF_TEMPLATE.format(host=a.domain or public_ip(), port=port, domain=domain,
                                       whitelist=", ".join(f'"{x}"' for x in wl))
    import secrets as _s
    users = toml_table(old, "access.users") if old else {}
    users.setdefault(TELEMT_KEEPER, _s.token_hex(16))
    text += "[access.users]\n" + "".join(f'{k} = "{v}"\n' for k, v in users.items())
    off = [k for k, v in (toml_table(old, "access.user_enabled") if old else {}).items() if v == "false"]
    if off:
        text += "\n[access.user_enabled]\n" + "".join(f"{k} = false\n" for k in off)
    if old and a.sni and a.sni.lower() != (toml_get(old, "censorship", "tls_domain") or ""):
        say("the site changed: links issued before stop working, clients need new ones")
    os.makedirs(TELEMT_DIR, mode=0o755, exist_ok=True)
    tm_write_conf(text)
    tm_run(image, text)
    tg_selftest("telemt", port, domain)
    say(f"telemt is running on TCP {port}, pretending to be {domain}")
    return {"ok": True, "unit": "telemt", "port": port, "sni": domain}


def mtg_run(image, port):
    sh(["docker", "rm", "-f", "mtg-doppel"], check=False)
    sh(["docker", "run", "-d", "--name", "mtg-doppel", "--restart", "unless-stopped", "-p", f"{port}:3128/tcp",
        "-v", f"{MTG_DIR}/config.toml:/config.toml:ro", "--log-driver", "json-file", "--log-opt", "max-size=20m",
        "--log-opt", "max-file=3", image, "run", "/config.toml"])
    time.sleep(3)   # a bad config makes mtg exit at once
    if "mtg-doppel" not in docker_names():
        logs = sh(["docker", "logs", "--tail", "5", "mtg-doppel"], check=False)
        raise Fail("mtg did not start; see: docker logs mtg-doppel — " + (logs.stdout + logs.stderr).strip()[-300:])


def install_mtg(a):
    image = ensure_image("mtg")
    old = host_read(f"{MTG_DIR}/config.toml")
    old_port = mtg_port() if old is not None else 0
    if old is not None and not a.port and not a.sni and old_port:
        _, domain = mtg_secret(old)
        say(f"keeping existing config and link (TCP {old_port}, site {domain})")
        mtg_run(image, old_port)
        tg_selftest("mtg", old_port, domain)
        return {"ok": True, "unit": "mtg-doppel", "port": old_port, "sni": domain}
    old_secret, old_domain = mtg_secret(old) if old is not None else ("", "")
    domain = (a.sni or old_domain or "www.intel.com").lower()
    check_domain(domain)
    port = tg_port(a.port, old_port, 9443, "mtg")
    front = tg_reachable(domain)
    # Doppelganger needs real HTTPS pages of the site it imitates (mtg fetches them to learn the timing)
    urls = MTG_URLS.get(domain)
    if not urls:
        same_host = front.split("/")[2].lower() == domain if front.count("/") >= 2 else False
        urls = [front if same_host else f"https://{domain}/"]
        say(f"Doppelganger will sample {urls[0]} (the front page; for a closer imitation put more pages of "
            f"{domain} into {MTG_DIR}/config.toml)")
    if domain == old_domain:
        secret = old_secret   # same site: the link stays valid
    else:
        import secrets as _s
        secret = "ee" + _s.token_hex(16) + domain.encode().hex()
        if old_secret:
            say("the site changed: the old link stops working, hand out the new one")
    os.makedirs(MTG_DIR, mode=0o755, exist_ok=True)
    host_write("mtg-doppel", f"{MTG_DIR}/config.toml",
               MTG_CONF_TEMPLATE.format(secret=secret, urls=", ".join(f'"{u}"' for u in urls)), 0o600)
    host_write("mtg-doppel", f"{MTG_DIR}/meta.json", json.dumps({"port": port, "domain": domain}, indent=2), 0o600)
    mtg_run(image, port)
    tg_selftest("mtg", port, domain)
    say(f"mtg is running on TCP {port}, pretending to be {domain}")
    return {"ok": True, "unit": "mtg-doppel", "port": port, "sni": domain}


INSTALLERS = {"awg3": install_awg3, "sstp": install_sstp, "vless": install_vless,
              "telemt": install_telemt, "mtg": install_mtg}
UNIT_OF = {"awg3": "awg3", "sstp": "sstp", "vless": "xray", "telemt": "telemt", "mtg": "mtg-doppel"}
DATA_DIR = {"sstp": SSTP_DIR, "vless": XRAY_DIR, "telemt": TELEMT_DIR, "mtg": MTG_DIR}


def cmd_install(a):
    if os.geteuid() != 0:
        raise Fail("install needs root")
    if free_mb() < 300:
        raise Fail(f"only {free_mb()} MB free on /, need at least 300 MB")
    ensure_docker()
    if systemd_enabled("netfilter-persistent"):
        say("WARNING: netfilter-persistent is enabled — do not run 'netfilter-persistent save' while containers run")
    return INSTALLERS[a.proto](a)


def systemd_enabled(unit):
    return subprocess.run(["systemctl", "is-enabled", "--quiet", unit], capture_output=True).returncode == 0


def cmd_uninstall(a):
    if os.geteuid() != 0:
        raise Fail("uninstall needs root")
    if a.proto == "awg3":
        p = subprocess.run([os.path.join(LIB_DIR, "install-awg3.sh"), "--remove"], capture_output=True, text=True)
        say((p.stdout + p.stderr).strip())
        return {"ok": p.returncode == 0, "unit": "awg3", "kept": "/opt/awg3"}
    unit = UNIT_OF[a.proto]
    sh(["docker", "rm", "-f", unit], check=False)
    kept = None
    d = DATA_DIR[a.proto]
    if os.path.isdir(d):
        kept = f"{d}.removed-{time.strftime('%Y%m%d-%H%M%S')}"
        os.rename(d, kept)
    say(f"{unit} removed" + (f"; data moved to {kept}" if kept else ""))
    return {"ok": True, "unit": unit, "kept": kept}


def cmd_preflight(_a):
    docker = subprocess.run(["sh", "-c", "command -v docker"], capture_output=True).returncode == 0
    mem = {}
    for line in (host_read("/proc/meminfo", "") or "").splitlines():
        k, _, v = line.partition(":")
        mem[k] = int(v.split()[0]) // 1024 if v.split() else 0
    osr = {}
    for line in (host_read("/etc/os-release", "") or "").splitlines():
        k, _, v = line.partition("=")
        osr[k] = v.strip('"')
    return {"version": VERSION, "os": osr.get("PRETTY_NAME", "?"), "kernel": os.uname().release,
            "docker": docker, "free_mb": free_mb(), "mem_avail_mb": mem.get("MemAvailable", 0),
            "swap_mb": mem.get("SwapTotal", 0), "public_ip": public_ip(),
            "ppp": os.path.exists("/dev/ppp") or subprocess.run(["modinfo", "ppp_generic"], capture_output=True).returncode == 0,
            "units": running_units() if docker else (["sstp-host"] if host_sstp_active() else []),
            "tcp_busy": sorted(busy_ports("tcp")), "udp_busy": sorted(busy_ports("udp")),
            "netfilter_persistent": systemd_enabled("netfilter-persistent")}


def cmd_unlink(_a):
    """Remove the panel's key from authorized_keys (the panel forgets this server)."""
    path = "/root/.ssh/authorized_keys"
    lines = (host_read(path, "") or "").splitlines()
    keep = [x for x in lines if "vpn-panel@" not in x]
    host_write("ssh", path, "\n".join(keep) + ("\n" if keep else ""), 0o600)
    return {"ok": True, "removed": len(lines) - len(keep)}


def cmd_version(_a):
    return {"version": VERSION}


def build_parser():
    ap = argparse.ArgumentParser(prog="vpnctl")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    d = sub.add_parser("dump")
    d.add_argument("containers", nargs="*")
    for name in ("params", "next-ip"):
        sub.add_parser(name).add_argument("container")
    ad = sub.add_parser("add")
    ad.add_argument("container")
    ad.add_argument("--pub", required=True)
    ad.add_argument("--ip", default="")
    ad.add_argument("--name", default="")
    for name in ("remove", "disable", "enable"):
        x = sub.add_parser(name)
        x.add_argument("container")
        x.add_argument("--pub", required=True)
    sn = sub.add_parser("set-name")
    sn.add_argument("container")
    sn.add_argument("--pub", required=True)
    sn.add_argument("--name", required=True)
    ins = sub.add_parser("install")
    ins.add_argument("proto", choices=sorted(INSTALLERS))
    ins.add_argument("--port", type=int)
    ins.add_argument("--sni", default="", help="vless: REALITY target; telemt/mtg: the site the proxy pretends to be")
    ins.add_argument("--domain", default="")
    ins.add_argument("--cert", default="", help="sstp: certificate chain file to use instead of a self-signed one")
    ins.add_argument("--key", default="", help="sstp: private key for --cert")
    un = sub.add_parser("uninstall")
    un.add_argument("proto", choices=sorted(INSTALLERS))
    for name in ("preflight", "unlink", "version"):
        sub.add_parser(name)
    return ap


HANDLERS = {"list": cmd_list, "dump": cmd_dump, "params": cmd_params, "next-ip": cmd_next_ip,
            "add": cmd_add, "remove": cmd_remove, "disable": cmd_disable, "enable": cmd_enable,
            "set-name": cmd_set_name, "install": cmd_install, "uninstall": cmd_uninstall,
            "preflight": cmd_preflight, "unlink": cmd_unlink, "version": cmd_version}
WRITES = {"add", "remove", "disable", "enable", "set-name", "install", "uninstall", "unlink"}


def main(argv):
    if argv[:1] == ["--ssh"]:
        # Forced command in authorized_keys: only "vpnctl <args>" (or the old name awgctl) runs.
        orig = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        if not orig or os.path.basename(orig[0]) not in ("vpnctl", "awgctl"):
            print(json.dumps({"error": "only vpnctl is allowed"}))
            return 2
        argv = orig[1:]
    try:
        a = build_parser().parse_args(argv)
    except SystemExit:
        print(json.dumps({"error": "bad arguments"}))
        return 2
    try:
        with open(LOCK, "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX if a.cmd in WRITES else fcntl.LOCK_SH)
            print(json.dumps(HANDLERS[a.cmd](a), ensure_ascii=False), flush=True)
        return 0
    except (Fail, ValueError, KeyError, StopIteration, json.JSONDecodeError, subprocess.TimeoutExpired) as e:
        print(json.dumps({"error": str(e) or e.__class__.__name__}, ensure_ascii=False), flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
