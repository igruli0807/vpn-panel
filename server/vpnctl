            raise Fail("--cert and --key must both point to existing files")
        say(f"using certificate {a.cert}")
        host_write("sstp", f"{SSTP_DIR}/server.crt", host_read(a.cert), 0o644)
        host_write("sstp", f"{SSTP_DIR}/server.key", host_read(a.key), 0o600)
    if not os.path.exists(f"{SSTP_DIR}/server.crt"):
        ip = public_ip()
        san = f"IP:{ip}" + (f",DNS:{a.domain}" if a.domain else "")
        cn = a.domain or ip
        say(f"self-signed certificate for {cn} (10 years)")
        sh(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650", "-subj", f"/CN={cn}",
            "-addext", f"subjectAltName={san}", "-keyout", f"{SSTP_DIR}/server.key", "-out", f"{SSTP_DIR}/server.crt"])
        os.chmod(f"{SSTP_DIR}/server.key", 0o600)
    sh(["docker", "rm", "-f", "sstp"], check=False)
    sh(["docker", "run", "-d", "--name", "sstp", "--restart", "unless-stopped", "--cap-add", "NET_ADMIN",
        "--device", "/dev/ppp", "--sysctl", "net.ipv4.ip_forward=1", "-p", f"{port}:{port}/tcp",
        "-v", f"{SSTP_DIR}:/etc/accel-ppp", "--log-driver", "json-file", "--log-opt", "max-size=5m",
        "--log-opt", "max-file=2", "--memory", "128m", image])
