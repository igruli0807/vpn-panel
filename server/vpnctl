    if not wait_for(lambda: accel(u, "show", "stat").returncode == 0, 30):
        raise Fail("sstp container started but accel-ppp does not answer; see: docker logs sstp")
    say(f"SSTP is running on TCP {port}")
    return {"ok": True, "unit": "sstp", "port": port}


SNI_CANDIDATES = ["www.apple.com", "dl.google.com", "www.microsoft.com"]


def xr_selftest(image, port, pbk, sid, sni, flow="xtls-rprx-vision"):
    """Real REALITY client on this host: temp user -> xray client (host network) -> HTTP 204 through the tunnel.
    `xray tls ping` alone is not enough: www.microsoft.com passes it, yet REALITY handshakes to it fail."""
    if subprocess.run(["sh", "-c", "command -v curl"], capture_output=True).returncode != 0:
        say("curl is not installed — skipping the end-to-end self-test")
        return True
    import uuid as _u
    tmp_id = str(_u.uuid4())
    _, inbound, _, _ = xr_load()
    xr_live_add(inbound, {"id": tmp_id, "email": tmp_id, "flow": flow})
    socks = pick_port("tcp")
    cfg = {"log": {"loglevel": "warning"},
           "inbounds": [{"listen": "127.0.0.1", "port": socks, "protocol": "socks", "settings": {"udp": False}}],
           "outbounds": [{"protocol": "vless", "settings": {"vnext": [{"address": "127.0.0.1", "port": port,
                          "users": [{"id": tmp_id, "encryption": "none", "flow": flow}]}]},
                          "streamSettings": {"network": "tcp", "security": "reality",
                                             "realitySettings": {"serverName": sni, "fingerprint": "chrome",
                                                                 "publicKey": pbk, "shortId": sid}}}]}
    sh(["docker", "rm", "-f", "vpnctl-selftest"], check=False)
    ok = False
    try:
        sh(["docker", "run", "-d", "--name", "vpnctl-selftest", "--network", "host", "--entrypoint", "sh", image, "-c",
            "cat > /tmp/c.json <<'JSON'\n" + json.dumps(cfg) + "\nJSON\nexec xray run -config /tmp/c.json"])
        for _ in range(8):
            time.sleep(1)
            p = subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", "6", "-w", "%{http_code}", "--socks5-hostname",
                                f"127.0.0.1:{socks}", "http://cp.cloudflare.com/generate_204"], capture_output=True, text=True)
            if p.stdout.strip() in ("204", "200"):
                ok = True
                break
    finally:
        sh(["docker", "rm", "-f", "vpnctl-selftest"], check=False)
        xr_live_remove(tmp_id)
    return ok


def xr_write_config(port, priv, pub, sid, sni, clients):
    f = xr_files()
    cfg = {
        "log": {"loglevel": "warning"},
        "api": {"tag": "api", "listen": XRAY_API, "services": ["HandlerService", "StatsService"]},
        "stats": {},
        "policy": {"levels": {"0": {"statsUserUplink": True, "statsUserDownlink": True, "statsUserOnline": True}},
                   "system": {"statsInboundUplink": True, "statsInboundDownlink": True}},
        "inbounds": [{"tag": XRAY_TAG, "listen": "0.0.0.0", "port": port, "protocol": "vless",
                      "settings": {"clients": clients, "decryption": "none"},
                      "streamSettings": {"network": "tcp", "security": "reality",
                                         "realitySettings": {"dest": f"{sni}:443", "serverNames": [sni],
                                                             "privateKey": priv, "shortIds": [sid]}},
                      "sniffing": {"enabled": True, "destOverride": ["http", "tls", "quic"]}}],
        "outbounds": [{"protocol": "freedom", "tag": "direct"}, {"protocol": "blackhole", "tag": "block"}],
    }
    host_write("xray", f["config"], json.dumps(cfg, ensure_ascii=False, indent=2))
